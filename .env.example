# Required: sign guest and account sessions (32+ random characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL is required for email signup/login and persistent rate limits
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=wine_ai
DB_SSL=false

# Optional: comma-separated allowed browser origins; leave empty for same-origin Vercel deployment
ALLOWED_ORIGINS=

# Optional
REQUEST_TIMEOUT=25000
PORT=3000
